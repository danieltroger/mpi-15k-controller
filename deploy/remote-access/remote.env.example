# Template for /etc/remote-access/remote.env, the host-local settings of reverse-tunnel@.service. They
# are host-specific and stay out of this public repo. Create the real file as root, mode 0600 (systemd
# reads it as root), with the values the old /etc/rc.local autossh lines used. See deploy/README.md.

# The `user@host` argument and the `-p` port of the old autossh lines.
TUNNEL_REMOTE_LOGIN="tunnel-user@tunnel-host.example"
TUNNEL_REMOTE_PORT="22"
